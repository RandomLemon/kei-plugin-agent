# 复制为 .env（已被 git 忽略）后填写；留空的项不生效，沿用 config.yaml。规则见 docs/testing.md §11.5。
# KEI_PLUGINS_* / KEI_BOTS_* 的列表值用 YAML 写法（如 [123456]）；KEI_AUTH_ADMIN_USERS 用逗号分隔。

# ---- LLM ----
KEI_PLUGINS_PERSONA_LLM_BASE_URL=https://api.openai.com/v1
KEI_PLUGINS_PERSONA_LLM_API_KEY=
KEI_PLUGINS_PERSONA_LLM_MODEL=gpt-4o-mini

# ---- 真实 QQ（SnowLuma OneBot 正向 WebSocket）；ENABLED 留空即只用 mock ----
# 例：ENABLED=true，WS_URL=ws://10.0.0.20:3001；ACCESS_TOKEN 与 SnowLuma wsServers 的 accessToken 一致
KEI_BOTS_QQ_MAIN_ENABLED=
KEI_BOTS_QQ_MAIN_WS_URL=
KEI_BOTS_QQ_MAIN_ACCESS_TOKEN=
# bot 自己的 QQ 号（适配器级，事件缺少 self_id 时兜底）
KEI_BOTS_QQ_MAIN_SELF_ID=
# bot 自己的 QQ 号，如 [123456]：只有 @它 才算寻址（为空时 @任何人都算）
KEI_PLUGINS_PERSONA_SELF_IDS=
# 允许说话的测试群，如 [654321]
KEI_PLUGINS_PERSONA_GROUP_LIST=

# ---- 管理员（多平台时必须带平台前缀），例：onebot:123456,mock:u1 ----
KEI_AUTH_ADMIN_USERS=mock:u1

# ---- 时区（{{now}}、静默时段与摘要日界）；留空即 Local，正式部署必须显式写，如 Asia/Shanghai ----
KEI_PLUGINS_PERSONA_RANDOM_TIMEZONE=

# ---- kei 自身存储（/agent 运行时覆盖）；留空即 memory，重启即丢 ----
# 例：KEI_STORAGE_TYPE=sqlite，KEI_STORAGE_DSN=/opt/kei/kei.db
KEI_STORAGE_TYPE=
KEI_STORAGE_DSN=

# ---- 记忆库（留空即关闭记忆功能）----
# 例：postgres://persona:<密码>@10.0.0.20:5432/persona?sslmode=disable
KEI_PLUGINS_PERSONA_MEMORY_DATABASE_DSN=
